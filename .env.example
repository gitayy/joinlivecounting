# https://old.reddit.com/prefs/apps/
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# "redirect uri" at https://old.reddit.com/prefs/apps/
OAUTH_REDIRECT_URI=http://localhost:8080/callback

# Format: <platform>:<app id>:<version> (by /u/<owner>)
REDDIT_USER_AGENT=web:gg.counting.joinlive:v0.1.0 (by /u/joinlivecounting)

# From `python -m joinlivecounting.scripts.bootstrap_token`, run as the bot account
REDDIT_BOT_REFRESH_TOKEN=

# python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=


### Optional
# PORT=8080
# THREADS_FILE=threads.json
# DATABASE_FILE=joins.db
# CONTRIBUTOR_SCAN_SECONDS=86400
# SCAN_CHECK_SECONDS=300
# ALLOWED_RETURN_HOSTS=counting.gg,www.counting.gg,localhost:3000
# RESULT_REDIRECT_SECONDS=0.7

# Comma-separated, u/ prefix optional.
# JOIN_ALLOWLIST=
# JOIN_DENYLIST=
